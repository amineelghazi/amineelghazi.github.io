---
import { STATS } from "../data/stats.js";
import type { Lang } from "../data/i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
---

<section class="py-12 border-t border-[#ffffff10]">
  <div class="max-w-5xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-8">
    {STATS.map((stat) => (
      <div class="text-center">
        <p class="text-4xl md:text-5xl font-medium text-[var(--white)]">{stat.value}</p>
        <p class="mt-2 text-sm text-[var(--white-icon)]">{stat.label[lang]}</p>
      </div>
    ))}
  </div>
</section>